# Local agent tooling (skill registry): per machine, never committed
.atl/

# graphify: only the graph and its report are shared; the HTML is rebuilt from
# graph.json (`graphify export html`), the rest is local tool state
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
