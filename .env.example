# Obligatorias
ALCAMPO_BASE_URL=https://www.compraonline.alcampo.es
REDIS_URL=redis://localhost:6379/0

# Opcionales (valor por defecto indicado)
CACHE_TTL_SECONDS=3600
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
# Jitter aleatorio máximo (s) sumado a cada espera entre reintentos. 0 = sin jitter.
RETRY_JITTER_MAX_S=0.3
# Segundos sin llamar a Alcampo tras un challenge de su WAF. 0 = desactivado.
WAF_COOLDOWN_SECONDS=180
LOG_LEVEL=INFO

# Tokens válidos para la cabecera X-API-Key, separados por comas. Vacío = nadie entra.
API_KEYS=xxx

# Límite global de peticiones a Alcampo, compartido por todas las instancias (spec 008).
# Estimación prudente: el umbral real del WAF para la búsqueda es desconocido. 0 = sin límite.
ALCAMPO_RATE_LIMIT=20
# Ventana del límite anterior, en segundos (mínimo 1).
ALCAMPO_RATE_WINDOW_SECONDS=60
# Tiempo máximo total de una búsqueda en Alcampo (intentos y esperas incluidos). > 0.
SEARCH_TIMEOUT_SECONDS=15
# Tope del enfriamiento creciente tras challenges seguidos del WAF (180 → 360 → 720 → 900).
# Debe ser >= WAF_COOLDOWN_SECONDS.
WAF_COOLDOWN_MAX_SECONDS=900

# Timeout de conexión y de cada operación con Redis, en segundos (> 0). Sin él, un Redis
# colgado deja las peticiones esperando para siempre (spec 007).
REDIS_TIMEOUT_SECONDS=2
# Cuánto se recuerda la región de un código postal (resolverla cuesta ~8 peticiones a Alcampo).
REGION_CACHE_TTL_SECONDS=604800
# Cuánto se recuerda que un código postal no existe o no tiene servicio (-> 404).
REGION_NEGATIVE_CACHE_TTL_SECONDS=3600
# Máximo de resoluciones nuevas (creación de destinos, el paso más sensible al WAF) por ventana.
# 0 = sin límite.
REGION_RESOLUTION_LIMIT=2
REGION_RESOLUTION_WINDOW_SECONDS=600
# La sesión de cada región se renueva al superar esta edad (por debajo de la hora de VISITORID).
SESSION_MAX_AGE_SECONDS=3000

REDIS_CIRCUIT_OPEN_SECONDS=10